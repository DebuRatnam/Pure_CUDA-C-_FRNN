#include <cuda_runtime.h>
#include <iostream>
#include <vector>
#include <chrono>
#include "prefix_sum.h"

void cpu_prefix_sum(const std::vector<int>& in, std::vector<int>& out, int n) {
    int sum = 0;
    for (int i = 0; i < n; ++i) {
        out[i] = sum;
        sum += in[i];
    }
}

void run_test_iteration(int n) {
    size_t size = n * sizeof(int);
    std::vector<int> h_in(n, 1);
    std::vector<int> h_out_gpu(n);
    std::vector<int> h_out_cpu(n);

    // CPU
    auto s_cpu = std::chrono::high_resolution_clock::now();
    cpu_prefix_sum(h_in, h_out_cpu, n);
    auto e_cpu = std::chrono::high_resolution_clock::now();
    double cpu_ms = std::chrono::duration<double, std::milli>(e_cpu - s_cpu).count();

    // GPU
    int *d_in, *d_out;
    cudaMalloc(&d_in, size);
    cudaMalloc(&d_out, size);
    cudaMemcpy(d_in, h_in.data(), size, cudaMemcpyHostToDevice);

    auto s_gpu = std::chrono::high_resolution_clock::now();
    run_prefix_sum(d_out, d_in, n);
    cudaDeviceSynchronize();
    auto e_gpu = std::chrono::high_resolution_clock::now();
    double gpu_ms = std::chrono::duration<double, std::milli>(e_gpu - s_gpu).count();

    // Verification check
    cudaMemcpy(h_out_gpu.data(), d_out, size, cudaMemcpyDeviceToHost);
    bool match = (h_out_gpu[n-1] == h_out_cpu[n-1]);

    // CSV Output: N, CPU_ms, GPU_ms, Speedup, Valid
    std::cout << n << "," << cpu_ms << "," << gpu_ms << "," << (cpu_ms / gpu_ms) << "," << (match ? "1" : "0") << std::endl;

    cudaFree(d_in); cudaFree(d_out);
}

int main() {
    std::cout << "N,CPU_ms,GPU_ms,Speedup,Valid" << std::endl;

    for (int n = 8192; n <= (1 << 24); n *= 2) {
        run_test_iteration(n);
    }
    return 0;
}

