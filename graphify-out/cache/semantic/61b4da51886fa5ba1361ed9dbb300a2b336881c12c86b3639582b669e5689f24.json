{"nodes": [{"id": "frnnmaster_claude_md", "label": "FRNN-master Performance Engineering Handbook", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frnnmaster_frnn_engine_cu", "label": "frnn_engine.cu (CUDA engine)", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "line 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frnnmaster_run_frnn_isolated_py", "label": "_run_frnn_isolated.py (Pure CUDA Worker subprocess)", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "line 39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frnnmaster_benchmark_master_py", "label": "benchmark_master.py (Orchestrator)", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "line 66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frnnmaster_subprocess_isolation", "label": "Subprocess Isolation for FRNN Timing", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PyTorch's caching allocator pre-warms the CUDA context, cuBLAS/cuDNN init steals 100-300 ms, and torch.cuda.synchronize() syncs all streams including FRNN's. Timing FRNN in the same process as PyTorch produces contaminated numbers. IPC overhead is per-invocation, not per-trial."}, {"id": "frnnmaster_auto_dispatch", "label": "Grid vs Brute-Force Auto-Dispatch", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grid dispatch when 3^D < total_cells; tiled brute-force when 3^D >= total_cells or res <= 1. BF path engages automatically for all high-D cases."}, {"id": "frnnmaster_adaevolve_concept", "label": "AdaEvolve: Adaptive LLM Driven Zeroth-Order Optimization", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "line 31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instead of manually guessing tuning tactics, SkyDiscover's adaevolve engine can autonomously discover algorithmic optimizations guided by an adaptive LLM-driven hierarchical search."}, {"id": "frnnmaster_test_frnn_specific_py", "label": "test_frnn_specific.py (Known bug: import fais)", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "line 10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frnnmaster_backward_cu", "label": "frnn/csrc/backward/backward.cu (dead legacy code)", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "line 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "frnnmaster_claude_md", "target": "frnnmaster_frnn_engine_cu", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 7", "weight": 1.0}, {"source": "frnnmaster_claude_md", "target": "frnnmaster_run_frnn_isolated_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 39", "weight": 1.0}, {"source": "frnnmaster_claude_md", "target": "frnnmaster_benchmark_master_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 66", "weight": 1.0}, {"source": "frnnmaster_claude_md", "target": "frnnmaster_subprocess_isolation", "relation": "defines", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 17", "weight": 1.0}, {"source": "frnnmaster_claude_md", "target": "frnnmaster_auto_dispatch", "relation": "defines", "confidence": "EXTRACTED", "confidence_sc